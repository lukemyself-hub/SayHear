DATABASE_URL=postgresql://user:password@host/database
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-server-only-secret
SAYHEAR_AUTH_SECRET_SOURCE=managed
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
SAYHEAR_BACKUP_POLICY_VERSION=replace-with-verified-policy-version
SAYHEAR_BACKUP_CONFIGURATION_FINGERPRINT=replace-with-configuration-fingerprint
SAYHEAR_INTERNAL_OWNER_ISSUER=https://github.com
SAYHEAR_INTERNAL_OWNER_SUBJECT=replace-with-github-numeric-user-id
SAYHEAR_INTERNAL_OWNER_USER_ID=replace-with-pre-generated-uuidv7
SAYHEAR_BACKUP_VERIFIED_AT=2026-07-27T00:00:00.000Z
SAYHEAR_BACKUP_VALID_UNTIL=2026-08-27T00:00:00.000Z
SAYHEAR_DATABASE_RETENTION_DAYS=30
SAYHEAR_PITR_RETENTION_DAYS=7
SAYHEAR_SNAPSHOT_RETENTION_DAYS=30
SAYHEAR_BACKUP_EVIDENCE_REFERENCE=operator-controlled-reference
SAYHEAR_CONTEXT_HMAC_SECRET=replace-with-a-server-only-context-integrity-secret
CRON_SECRET=replace-with-a-random-server-only-cron-secret
SAYHEAR_INACTIVITY_POLICY_VERSION=continuous-exchange-inactivity:v1
SAYHEAR_INACTIVITY_TIMEOUT_MS=1800000
# 1A.2 Journal Eligibility durability foundation (issue #18, ADR-0066/0017).
SAYHEAR_JOURNAL_ELIGIBILITY_POLICY_VERSION=journal-eligibility:v1
SAYHEAR_MINIMUM_SUBSTANTIVE_EXPRESSION_LENGTH=20
SAYHEAR_OUTBOX_LEASE_DURATION_MS=60000
# Conversation Text Provider. "deepseek" is the default (see ADR-0102); switch to
# "openai" once the OpenAI account is restored. "deterministic" is test-only.
SAYHEAR_PROVIDER_ADAPTER=deepseek
DEEPSEEK_API_KEY=replace-with-a-server-only-provider-key
SAYHEAR_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-a-server-only-provider-key
SAYHEAR_PROVIDER_TIMEOUT_MS=60000
SAYHEAR_CONVERSATION_TEXT_MODEL=deepseek-v4-flash
SAYHEAR_CONVERSATION_TEXT_MODEL_SNAPSHOT=deepseek-v4-flash
# 1A.2 Internal Owner Full Purge (issue #27). The purge marker store is a
# separate database on the same PostgreSQL instance, outside the business
# database backup domain. It must never equal DATABASE_URL.
PURGE_MARKER_DATABASE_URL=postgresql://user:password@host/sayhear_purge_marker
SAYHEAR_PROVIDER_RETENTION_DAYS=30
