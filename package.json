{
  "name": "sayhear",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @sayhear/web build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:purge-surfaces": "tsx scripts/check-purge-surface-inventory.ts",
    "canary:workflow": "tsx scripts/verify-hosted-workflow-canary.ts",
    "release:g1:produce": "tsx scripts/produce-1a3b-g1-evidence.ts",
    "release:g1:build": "tsx scripts/build-1a3b-g1-release-manifest.ts",
    "release:g1:activate": "tsx scripts/activate-1a3b-g1.ts",
    "release:g1:rollback": "tsx scripts/rollback-1a3b-g1.ts",
    "release:g1:verify": "tsx scripts/verify-1a3b-g1-release-manifest.ts",
    "release:g2:build": "tsx scripts/build-1a3b-g2-release-manifest.ts",
    "release:g2:activate": "tsx scripts/activate-1a3b-g2.ts",
    "release:g2:rollback": "tsx scripts/rollback-1a3b-g2.ts",
    "release:g2:verify": "tsx scripts/verify-1a3b-g2-release-manifest.ts",
    "check:runtime": "node scripts/check-runtime.mjs",
    "db:migrate": "tsx packages/data/src/cli/migrate.ts",
    "db:provision-owner": "tsx packages/data/src/cli/provision-internal-owner.ts",
    "db:ensure-self-entity": "tsx packages/data/src/cli/ensure-self-entity.ts",
    "db:sync-predicate-registry": "tsx packages/data/src/cli/sync-predicate-registry.ts",
    "db:rebuild-relationship-hints": "tsx packages/data/src/cli/rebuild-relationship-hints.ts",
    "db:record-backup": "tsx packages/data/src/cli/record-backup-policy.ts",
    "test": "vitest run",
    "test:system": "vitest run tests/system",
    "test:system:cleanup": "tsx scripts/cleanup-test-schemas.ts",
    "test:system:neon": "vitest run tests/system --maxWorkers=1 --hookTimeout=120000 --testTimeout=120000",
    "eval:g2:v4:review": "node eval/continuation-acceptance-1a3b/serve-review-v4.mjs",
    "eval:g2:v4:unblind": "node --import tsx/esm eval/continuation-acceptance-1a3b/unblind-v4.ts",
    "eval:g2:v5:review": "node eval/continuation-acceptance-1a3b/serve-review-v5.mjs",
    "eval:g2:v5:unblind": "node --import tsx/esm eval/continuation-acceptance-1a3b/unblind-v5.ts",
    "eval:g2:v5:verify": "node --import tsx/esm eval/continuation-acceptance-1a3b/verify-g2-treatment-v5.ts",
    "eval:g2:v5:merge": "node --import tsx/esm eval/continuation-acceptance-1a3b/merge-v5-captures.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "validate": "pnpm check:runtime && pnpm check:boundaries && pnpm check:purge-surfaces && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@sayhear/ai": "workspace:*",
    "@sayhear/application": "workspace:*",
    "@sayhear/data": "workspace:*",
    "@sayhear/domain": "workspace:*",
    "@sayhear/test-support": "workspace:*",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
