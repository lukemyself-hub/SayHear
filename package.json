{
  "name": "sayhear",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @sayhear/web build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:purge-surfaces": "tsx scripts/check-purge-surface-inventory.ts",
    "check:schema-extensions": "tsx scripts/check-schema-extensions.ts",
    "canary:workflow": "tsx scripts/verify-hosted-workflow-canary.ts",
    "release:g1:produce": "tsx scripts/produce-1a3b-g1-evidence.ts",
    "release:g1:build": "tsx scripts/build-1a3b-g1-release-manifest.ts",
    "release:g1:activate": "tsx scripts/activate-1a3b-g1.ts",
    "release:g1:rollback": "tsx scripts/rollback-1a3b-g1.ts",
    "release:g1:verify": "tsx scripts/verify-1a3b-g1-release-manifest.ts",
    "release:config:compare": "tsx scripts/effective-runtime-config-gate.ts",
    "release:promotion:report": "tsx scripts/g1-promotion-config-report.ts",
    "release:validate": "tsx scripts/daily-release-validation.ts",
    "release:closure:report": "tsx scripts/release-closure-report.ts",
    "check:runtime": "node scripts/check-runtime.mjs",
    "db:migrate": "tsx packages/data/src/cli/migrate.ts",
    "db:provision-owner": "tsx packages/data/src/cli/provision-internal-owner.ts",
    "db:ensure-self-entity": "tsx packages/data/src/cli/ensure-self-entity.ts",
    "db:sync-predicate-registry": "tsx packages/data/src/cli/sync-predicate-registry.ts",
    "db:rebuild-relationship-hints": "tsx packages/data/src/cli/rebuild-relationship-hints.ts",
    "db:record-backup": "tsx packages/data/src/cli/record-backup-policy.ts",
    "test": "vitest run",
    "test:system": "vitest run tests/system",
    "test:ci": "vitest run --maxWorkers=2 --hookTimeout=60000 --reporter=default --reporter=json --outputFile.json=artifacts/vitest-report.json",
    "ci:verify-test-databases": "tsx scripts/ci/verify-test-databases.ts",
    "ci:assert-system-suites": "tsx scripts/ci/assert-system-suites-ran.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.g1-tools.json && pnpm -r --if-present typecheck",
    "validate": "pnpm check:runtime && pnpm check:boundaries && pnpm check:purge-surfaces && pnpm check:schema-extensions && pnpm typecheck && pnpm test:ci && pnpm build"
  },
  "devDependencies": {
    "@sayhear/ai": "workspace:*",
    "@sayhear/application": "workspace:*",
    "@sayhear/data": "workspace:*",
    "@sayhear/domain": "workspace:*",
    "@sayhear/test-support": "workspace:*",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
